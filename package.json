{
	"name": "@advers/eslint",
	"version": "2.1.0",
	"description": "Universal eslint rules set",
	"scripts": {
		"test": "npm run test:good && npm run test:bad",
		"test:good": "eslint test/03-good.ts",
		"test:bad": "eslint test/01-bad.ts test/02-bad.js; test $? -eq 1"
	},
	"peerDependencies": {
		"eslint": "^10",
		"typescript": ">=5"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"eslint-plugin-jsdoc": "^63.0.2"
	},
	"devDependencies": {
		"eslint": "^10",
		"typescript": "^6.0.3"
	}
}
