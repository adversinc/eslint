{
	"name": "@advers/eslint",
	"version": "2.3.0",
	"description": "Universal eslint rules set",
	"scripts": {
		"test": "npm run test:good && npm run test:bad && npm run test:decorators",
		"test:good": "eslint test/03-good.ts test/05-decorators-good.ts",
		"test:bad": "eslint test/01-bad.ts test/02-bad.js; test $? -eq 1",
		"test:decorators": "node --test test/06-decorators.test.mjs"
	},
	"peerDependencies": {
		"eslint": "^10",
		"typescript": ">=5"
	},
	"dependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@typescript-eslint/eslint-plugin": "^8.61.0",
		"@typescript-eslint/parser": "^8.61.0",
		"eslint-plugin-decorator-position": "^6.1.1",
		"eslint-plugin-jsdoc": "^63.0.2"
	},
	"devDependencies": {
		"eslint": "^10",
		"typescript": "^6.0.3"
	}
}
